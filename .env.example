# Supabase public project configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only service credential used by public operations (Tracking lookup,
# Tracking observation, Repair Request submission) so the publishable key
# cannot reach Postgres directly. NEVER expose through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only HMAC key for opaque public-operation abuse-control actor keys.
# Use at least 32 random characters and keep the same value across app instances.
PUBLIC_ABUSE_HMAC_SECRET=
# Separate proof shared only by the app and its trusted production ingress.
PUBLIC_ABUSE_TRUSTED_PROXY_SECRET=
# Local development only: place every request in one shared abuse-control
# bucket instead of requiring trusted ingress proof. Never enable in staging
# or production; leave blank to fail closed without a trusted ingress.
PUBLIC_ABUSE_SHARED_DEV_BUCKET=true
# Optional validated policy overrides (defaults shown).
PUBLIC_ABUSE_TRACKING_LOOKUP_MAX=30
PUBLIC_ABUSE_TRACKING_LOOKUP_WINDOW_SECONDS=60
PUBLIC_ABUSE_REPAIR_REQUEST_MAX=5
PUBLIC_ABUSE_REPAIR_REQUEST_WINDOW_SECONDS=600

# Application origin URL (used for password reset emails and absolute redirect callbacks)
# Example: http://localhost:3000 (development) or https://app.tracknologia.com (production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email Delivery Configuration (Resend)
# Optional in development: if omitted, emails are safely logged to the server console
RESEND_API_KEY=
RESEND_FROM_EMAIL="Tracknologia <onboarding@resend.dev>"

# Email Confirmation Toggle
# Set to 'false' to immediately verify users on signup and skip email confirmation during development
NEXT_PUBLIC_REQUIRE_EMAIL_CONFIRMATION=false

# Never add Supabase service-role/secret values with NEXT_PUBLIC_ prefixes.
