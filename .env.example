# ==========================================
# Tracknologia Environment Configuration
# Copy this file to .env.local for development:
#   cp .env.example .env.local (or Copy-Item .env.example .env.local)
# ==========================================

# 1. Supabase Configuration (Hosted or Local)
# Hosted: Project Settings -> API in Supabase dashboard
# Local: Output from 'npx supabase status'
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. Abuse Control & Rate Limiting Secrets
# Generate random 32+ character hex strings:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PUBLIC_ABUSE_HMAC_SECRET=generate-a-random-32-char-secret-string-here
PUBLIC_ABUSE_TRUSTED_PROXY_SECRET=generate-a-different-32-char-secret-here

# 4. Local Development Mode for Abuse Control
# Set to 'true' for local development to bypass trusted proxy ingress requirement
PUBLIC_ABUSE_SHARED_DEV_BUCKET=true

# Optional: Rate Limit Tuning (defaults shown)
# PUBLIC_ABUSE_TRACKING_LOOKUP_MAX=30
# PUBLIC_ABUSE_TRACKING_LOOKUP_WINDOW_SECONDS=60
# PUBLIC_ABUSE_REPAIR_REQUEST_MAX=5
# PUBLIC_ABUSE_REPAIR_REQUEST_WINDOW_SECONDS=600

# 5. Email Configuration (Resend - Optional in dev)
# In development, omitting RESEND_API_KEY logs all emails to the terminal console
# RESEND_API_KEY=re_your_api_key_here
# RESEND_FROM_EMAIL=Tracknologia <onboarding@resend.dev>
